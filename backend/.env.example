# CredChain Backend Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:5173

# PostgreSQL Database Configuration
PGUSER=postgres
PGPASSWORD=your_postgres_password_here
PGHOST=localhost
PGPORT=5432
PGDATABASE=credchain
DATABASE_URL=postgresql://postgres:your_postgres_password_here@localhost:5432/credchain

# Authentication Secret & Expiration
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=24h

# Blockchain Smart Contract Configuration
BLOCKCHAIN_ENABLED=true
BLOCKCHAIN_NETWORK=Polygon Amoy Testnet (ChainID: 80002)
LOAN_CONTRACT_ADDRESS=0x3A2cE7495B5B84Ac544A30B48007C38B13dB5725
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
OPERATOR_PRIVATE_KEY=
