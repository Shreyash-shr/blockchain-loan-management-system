{
  "name": "credchain-loan-blockchain",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "frontend",
    "backend",
    "smart-contract"
  ],
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "preview": "npm --prefix frontend run preview",
    "frontend:dev": "npm --prefix frontend run dev",
    "frontend:build": "npm --prefix frontend run build",
    "backend:start": "node backend/src/app.js",
    "backend:dev": "npm --prefix backend run dev",
    "server:start": "node backend/src/app.js",
    "db:setup": "node database/setup.js",
    "db:reset": "node database/reset_and_seed.js",
    "test:phase4": "node backend/tests/verify_phase4.mjs",
    "test:phase5": "node backend/tests/verify_phase5.mjs",
    "test:phase8": "node backend/tests/verify_phase8.mjs",
    "test:e2e": "node backend/tests/verify_e2e_workflow.mjs",
    "smart-contract:compile": "npm --prefix smart-contract run compile",
    "smart-contract:test": "npm --prefix smart-contract run test"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.468.0",
    "multer": "^2.4.0",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "puppeteer-core": "^25.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4",
    "recharts": "^2.15.0",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "vite": "^6.0.5"
  }
}
